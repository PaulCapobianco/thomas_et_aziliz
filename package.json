{
  "name": "wedding-photo-album",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 scripts/serve.py --port 4173",
    "deploy": "bash scripts/deploy.sh",
    "preview": "npm run build && cd dist && python3 ../scripts/serve.py --port 4173",
    "vendor": "bash scripts/vendor.sh",
    "build": "node scripts/build.mjs",
    "check": "node --check app.js && node --check shared.js && node --check uploads.js && node --check admin.js",
    "test": "playwright test",
    "test:sql": "bash scripts/test-sql.sh",
    "test:real": "bash scripts/real-stack.sh test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "@tensorflow/tfjs": "4.22.0",
    "nsfwjs": "4.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@fontsource/cormorant-garamond": "5.2.8",
    "@fontsource/jost": "5.2.8",
    "@playwright/test": "1.58.2",
    "esbuild": "0.25.12",
    "wrangler": "^4.149.0"
  }
}
